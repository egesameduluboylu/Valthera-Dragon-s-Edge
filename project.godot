; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Valthera: Dragon's Edge"
run/main_scene="res://src/scenes/town/town.tscn"
config/features=PackedStringArray("4.5", "GL Compatibility")
config/version="0.5"
boot_splash/bg_color=Color(0.055, 0.031, 0.039, 1)
boot_splash/image="res://assets/brand/splash.png"
boot_splash/fullsize=true
config/icon="res://assets/brand/icon.png"

[autoload]

Settings="*res://src/autoload/settings.gd"
EventBus="*res://src/autoload/event_bus.gd"
DataDB="*res://src/autoload/data_db.gd"
SaveManager="*res://src/autoload/save_manager.gd"
GameState="*res://src/autoload/game_state.gd"
Audio="*res://src/autoload/audio.gd"

[display]

window/size/viewport_width=720
window/size/viewport_height=1280
window/size/window_width_override=405
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1

[input_devices]

pointing/emulate_touch_from_mouse=true

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
